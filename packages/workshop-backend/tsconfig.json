{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "esnext"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "./worker-configuration.d.ts"
    ],
    "outDir": "./dist",
    "declaration": true,
    "sourceMap": true,
    "noEmit": false,
    "baseUrl": ".",
    "paths": {
      "@gadgets/typed-storage": [
        "../typed-storage/src/index.ts"
      ],
      "@gadgets/workshop-shared/*": [
        "../workshop-shared/src/*"
      ],
      "pi-ai-copilot-oauth": [
        "./node_modules/@earendil-works/pi-ai/dist/auth/oauth/github-copilot"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}